# Required for production
DATABASE_URL=ecto://USER:PASS@HOST/DATABASE
SECRET_KEY_BASE=generate-with-mix-phx.gen.secret
PHX_HOST=your-domain.com
PHX_SERVER=true
PORT=4000

# Database options
DATABASE_SSL=true
POOL_SIZE=10
ECTO_IPV6=false

# Email (Mailgun) - Required for production
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=your-mailgun-domain.com

# Anthropic CLI Configuration
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=4096

# Optional
DNS_CLUSTER_QUERY=

# Gigalixir Deployment (CI/CD secrets)
# GIGALIXIR_EMAIL=your-email@example.com
# GIGALIXIR_PASSWORD=your-gigalixir-password
# GIGALIXIR_APP_NAME=your-app-name
